{
  "name": "@lumi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load": "vitest run --project load",
    "test:context:production-e2e": "vitest run tests/context-db-production-live-e2e.test.ts",
    "test:onboarding:production-e2e": "vitest run tests/character-onboarding-production-live-e2e.test.ts",
    "test:long-horizon:live": "playwright test --config playwright.long-horizon-live.config.ts",
    "ultef:s37-hook-reader": "vitest run tests/ultef-s37-hook-reader-production.v3.integration.test.ts",
    "ultef:s38-template-versioning": "vitest run tests/ultef-s38-template-versioning.v3.integration.test.ts",
    "ultef:s40-public-auth": "playwright test tests/e2e/s40-public-auth.spec.ts",
    "ultef:s41-parent-home": "vitest run tests/ultef-s41-parent-home-profile.contract.test.ts",
    "ultef:s44-memory-production": "vitest run tests/ultef-s44-memory-production.v3.integration.test.ts",
    "ultef:s45-memory-lifecycle": "vitest run tests/ultef-s45-memory-lifecycle.v3.integration.test.ts",
    "ultef:s46-memory-story": "vitest run tests/ultef-s46-memory-story-production.v3.integration.test.ts",
    "auth:migrate": "node scripts/auth-migrate.mjs",
    "db:compatibility-smoke": "node scripts/db-provider-compatibility-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rimraf .next coverage"
  },
  "dependencies": {
    "@lumi/context": "workspace:*",
    "@lumi/logger": "workspace:*",
    "@lumi/media": "workspace:*",
    "@lumi/npc-intelligence": "workspace:*",
    "@lumi/privacy": "workspace:*",
    "@lumi/profiles": "workspace:*",
    "@lumi/simulation": "workspace:*",
    "@lumi/story": "workspace:*",
    "@lumi/world": "workspace:*",
    "@next/env": "16.2.12",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.43.1",
    "jpeg-js": "^0.4.4",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/react": "16.3.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.2.0",
    "tailwindcss": "4.1.14",
    "vitest": "4.0.14"
  }
}
