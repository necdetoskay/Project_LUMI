{
  "name": "project-lumi",
  "version": "0.1.0",
  "private": true,
  "description": "Project LUMI monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ultef": "node tooling/ultef/src/cli.mjs",
    "ultef:selftest": "node tooling/ultef/src/cli.mjs selftest",
    "ultef:profile": "node tooling/ultef/src/cli.mjs L1-PROFILE-001",
    "ultef:isolation": "node tooling/ultef/src/cli.mjs L2-ISOLATION-MATRIX",
    "ultef:session-negative": "node tooling/ultef/src/cli.mjs L3-SESSION-NEGATIVE",
    "ultef:session-idempotency": "node tooling/ultef/src/cli.mjs L3-SESSION-IDEMPOTENCY",
    "ultef:session-single-active": "node tooling/ultef/src/cli.mjs L3-SESSION-003",
    "ultef:outcome-rejection": "node tooling/ultef/src/cli.mjs L4-OUTCOME-REJECTION",
    "ultef:npc-rumor": "node tooling/ultef/src/cli.mjs L3-NPC-001",
    "ultef:opportunity-hook": "node tooling/ultef/src/cli.mjs L4-OPPORTUNITY-HOOK-001",
    "ultef:hook-scene": "node tooling/ultef/src/cli.mjs L4-HOOK-SCENE-001",
    "ultef:scene-session": "node tooling/ultef/src/cli.mjs L4-SCENE-SESSION-001",
    "ultef:world-commit": "node tooling/ultef/src/cli.mjs PX-LUMI-09-001",
    "ultef:materialized-rumor": "node tooling/ultef/src/cli.mjs PX-LUMI-09-002",
    "ultef:golden": "node tooling/ultef/src/cli.mjs L6-GOLDEN-001",
    "ultef:integration": "node tooling/ultef/src/integration-suite.mjs",
    "ultef:L0": "node tooling/ultef/src/cli.mjs L0",
    "ultef:L1": "node tooling/ultef/src/cli.mjs L1",
    "ultef:L2": "node tooling/ultef/src/cli.mjs L2",
    "ultef:L3": "node tooling/ultef/src/cli.mjs L3",
    "ultef:L9": "node tooling/ultef/src/cli.mjs L9",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "infra:up": "node scripts/infra-up.mjs",
    "infra:down": "node scripts/infra-down.mjs",
    "infra:status": "node scripts/infra-status.mjs",
    "infra:logs": "node scripts/infra-logs.mjs",
    "infra:config": "node scripts/infra-config.mjs",
    "infra:reset": "node scripts/infra-reset.mjs",
    "auth:migrate": "pnpm --filter @lumi/web auth:migrate"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "rimraf": "6.1.2",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
