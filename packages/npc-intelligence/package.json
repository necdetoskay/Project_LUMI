{
  "name": "@lumi/npc-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./ports": "./src/ports/index.ts",
    "./application": "./src/application/index.ts",
    "./db": "./src/db/index.ts",
    "./db/client": "./src/db/client/index.ts",
    "./db/schema/npc-intelligence": "./src/db/schema/npc-intelligence/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:db:referential-integrity": "node scripts/referential-integrity-db-selftest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "npc:migrate": "node scripts/npc-migrate.mjs"
  },
  "dependencies": {
    "@lumi/profiles": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.11.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
