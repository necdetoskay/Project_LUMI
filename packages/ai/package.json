{
  "name": "@lumi/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./ports": "./src/ports/index.ts",
    "./infrastructure": "./src/infrastructure/index.ts",
    "./application": "./src/application/index.ts",
    "./validation": "./src/validation/index.ts",
    "./usage": "./src/usage/index.ts",
    "./evals": "./src/evals/index.ts",
    "./db": "./src/db/index.ts",
    "./db/client": "./src/db/client/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "ai:migrate": "node scripts/ai-migrate.mjs"
  },
  "dependencies": {
    "@lumi/context": "workspace:*",
    "@lumi/prompts": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.11.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
