NODE_ENV=production
# Build-time value: NEXT_PUBLIC_* is inlined into the client bundle at build.
# Must match the public URL users reach the app at (server host + WEB_PORT).
NEXT_PUBLIC_APP_URL=http://172.41.42.51:3001

# PostgreSQL configuration.
# DATABASE_URL is the normal runtime connection. For managed PostgreSQL this
# may be a pooled endpoint (for example a Neon pooled connection string).
# DATABASE_DIRECT_URL is reserved for migrations/admin/session-sensitive
# operations. Local deployments may point both values to the same PostgreSQL.
# Never commit real cloud credentials.
POSTGRES_DB=lumi
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi_local_only
DATABASE_URL=postgresql://lumi:lumi_local_only@postgres:5432/lumi
DATABASE_DIRECT_URL=postgresql://lumi:lumi_local_only@postgres:5432/lumi

REDIS_URL=redis://redis:6379

# HTTP erişimde Secure cookie engellenir; HTTPS'e geçildiğinde "true" yapın.
AUTH_COOKIE_SECURE=false

# Dışarıya açılan tek port (web). postgres/redis host'a publish edilmez.
WEB_PORT=3001

# Optional development/demo-only browser control at /demo-control.
# Keep disabled by default. When enabled, every prepare/status/reset action
# also requires the server-side token below. Use a long random value.
LUMI_DEMO_WEB_CONTROL_ENABLED=false
LUMI_DEMO_WEB_CONTROL_TOKEN=replace-with-a-long-random-token
# Used only to create/login the deterministic demo parent account.
LUMI_DEMO_PARENT_PASSWORD=replace-with-a-demo-parent-password
