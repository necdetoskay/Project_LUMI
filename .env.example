NODE_ENV=production
# Build-time value: NEXT_PUBLIC_* is inlined into the client bundle at build.
# Must match the public URL users reach the app at (server host + WEB_PORT).
NEXT_PUBLIC_APP_URL=http://172.41.42.51:3001

# Compose services are internal-only: postgres and redis are NOT exposed
# to the host. Only the web service publishes WEB_PORT. The web container
# reaches postgres/redis via the compose network (postgres:5432, redis:6379).
# To reach the DB from the host, exec into a container or use the web service.

POSTGRES_DB=lumi
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi_local_only
DATABASE_URL=postgresql://lumi:lumi_local_only@postgres:5432/lumi

REDIS_URL=redis://redis:6379

# HTTP erişimde Secure cookie engellenir; HTTPS'e geçildiğinde "true" yapın.
AUTH_COOKIE_SECURE=false

# Dışarıya açılan tek port (web). postgres/redis host'a publish edilmez.
WEB_PORT=3001
