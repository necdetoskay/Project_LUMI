{
  "services": {
    "postgres": {
      "required": true,
      "pinned_image": true,
      "healthcheck": "pg_isready",
      "named_volume": true,
      "host_binding": "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    },
    "cache": {
      "required": true,
      "protocol": "redis-compatible",
      "pinned_image": true,
      "healthcheck": "redis protocol ping",
      "named_volume": true,
      "host_binding": "127.0.0.1:${REDIS_PORT:-6379}:6379"
    },
    "object_storage": {
      "required": false,
      "compose_profile": "object-storage",
      "pinned_image": true,
      "named_volume": true,
      "public_bucket": false
    }
  },
  "root_scripts": [
    "infra:up",
    "infra:down",
    "infra:status",
    "infra:logs",
    "infra:reset"
  ],
  "reset_requires_explicit_confirmation": true
}
